{
  "dependencies": {
    "@langchain/core": "^1.1.44",
    "@langchain/langgraph": "^1.2.9",
    "@langchain/ollama": "^1.2.7",
    "@xyflow/react": "^12.8.7",
    "deepagents": "^1.9.1",
    "langchain": "^1.3.5",
    "lucide-react": "^0.468.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tar": "^7.5.15",
    "yaml": "^2.8.4",
    "zod": "^4.4.3"
  },
  "name": "recursive-language-modelv1",
  "version": "1.0.0",
  "description": "",
  "main": "dist/src/index.js",
  "bin": {
    "rlm": "dist/src/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "build": "tsc -p tsconfig.json",
    "build:ui": "vite build --config ui/vite.config.ts",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "package:build": "node scripts/packaging/build-release.mjs",
    "package:smoke": "npm run package:build && node scripts/packaging/smoke-release.mjs",
    "start": "node dist/src/index.js",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run depcruise:strict && npm test",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "lint": "eslint src tests ui/src",
    "lint:eslint": "eslint src tests ui/src",
    "format": "prettier --write src tests ui/src",
    "format:check": "prettier --check src tests ui/src",
    "depcruise:ci": "dependency-cruise src --config .dependency-cruiser.js --ignore-known dependency-cruiser-baseline.json",
    "depcruise:strict": "dependency-cruise src --config .dependency-cruiser.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.2.7"
  }
}
