{
  "dependencies": {
    "@langchain/core": "^1.1.44",
    "@langchain/langgraph": "^1.2.9",
    "@langchain/ollama": "^1.2.7",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@xyflow/react": "^12.8.7",
    "deepagents": "^1.9.1",
    "langchain": "^1.3.5",
    "lucide-react": "^0.468.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "tar": "^7.5.15",
    "yaml": "^2.8.4",
    "zod": "^4.4.3"
  },
  "name": "recursive-language-modelv1",
  "version": "1.0.0",
  "description": "",
  "bin": {
    "rlm": "scripts/rlm-runtime.mjs"
  },
  "scripts": {
    "dev:ui": "vite --config ui/vite.config.ts",
    "dev:ui:full": "node -e \"console.log('Two-terminal UI dev (Rust API):\\\\n  Terminal 1: RLM_UI_DIST= cargo run -p rlm-cli -- ui --port 8787\\\\n  Terminal 2: RLM_CONTROL_PORT=8787 npm run dev:ui')\"",
    "build": "tsc -p tsconfig.json",
    "build:ui": "vite build --config ui/vite.config.ts",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "package:build": "node scripts/packaging/build-release.mjs",
    "package:smoke": "npm run package:build && node scripts/packaging/smoke-release.mjs",
    "package:smoke:deb": "node scripts/packaging/smoke-deb.mjs",
    "test:packaging": "node --import ./scripts/test-ram-preload.mjs --test scripts/packaging/deb-smoke-lib.test.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run depcruise:strict && npm test",
    "check:rust": "cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && npm run check:rust:boundaries && cargo check -p rlm-core -p rlm-cli",
    "check:rust:boundaries": "node --import ./scripts/test-ram-preload.mjs --test scripts/rust-boundary-check.test.mjs && bash scripts/check-rust-boundaries.sh",
    "check:rust:boundaries:strict": "bash scripts/check-rust-boundaries.sh --strict",
    "check:parity": "node scripts/cargo-with-ram-gate.mjs -- cargo test -p rlm-core control_server_matches_golden_fixtures -- --nocapture",
    "rlm:rust": "cargo run -p rlm-cli --",
    "rlm": "node scripts/rlm-runtime.mjs",
    "lint": "eslint src tests ui/src",
    "lint:eslint": "eslint src tests ui/src",
    "format": "prettier --write src tests ui/src",
    "format:check": "prettier --check src tests ui/src",
    "depcruise:ci": "dependency-cruise src --config .dependency-cruiser.js --ignore-known dependency-cruiser-baseline.json",
    "depcruise:strict": "dependency-cruise src --config .dependency-cruiser.js",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-test-suite.mjs",
    "test:rlm-runtime": "node --import ./scripts/test-ram-preload.mjs --test scripts/rlm-runtime.test.mjs",
    "test:agent:verify": "node scripts/agent-safe-verify.mjs --profile reg01",
    "test:agent:verify:light": "node scripts/agent-safe-verify.mjs --profile light",
    "test:uat:preflight": "node scripts/agent-safe-verify.mjs --profile reg01",
    "test:reg03:preflight": "node scripts/agent-safe-verify.mjs --profile reg03"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tauri-apps/cli": "^2.11.2",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "dependency-cruiser": "^17.4.0",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^7.2.7"
  }
}
